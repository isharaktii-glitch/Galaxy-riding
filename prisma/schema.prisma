generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  role          String    // "PASSENGER" or "DRIVER"
  phone         String?
  whatsapp      String?
  education     String?   // Passenger Profile Details
  kycVerified   Boolean   @default(false)
  currentLat    Float?    // Live GPS Location
  currentLng    Float?    
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  passengerId   String
  driverId      String?
  passenger     User     @relation(fields: [passengerId], references: [id])
  pickupLat     Float
  pickupLng     Float
  destLat       Float
  destLng       Float
  status        String   @default("SEARCHING") // SEARCHING, ACCEPTED, COMPLETED
  createdAt     DateTime @default(now())
}
